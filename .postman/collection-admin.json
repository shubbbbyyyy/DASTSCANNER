		{
			"name": "KYC",
			"item": [
				{
					"name": "Get KYC Applications By ID",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Parse response",
									"const res = pm.response.json();",
									"",
									"// Initialize result",
									"const reviews = [];",
									"",
									"// Safety check",
									"if (res?.data?.fieldGroups) {",
									"  res.data.fieldGroups.forEach(group => {",
									"    group.fields.forEach(field => {",
									"      const fieldValueId = field?.value?.id;",
									"",
									"      if (fieldValueId) {",
									"        reviews.push({",
									"          fieldValueId,",
									"          comment: \"\",",
									"          status: \"approved\",",
									"        });",
									"      }",
									"    });",
									"  });",
									"}",
									"",
									"// Final output",
									"const result = { reviews };",
									"",
									"// Log it",
									"console.log(\"Transformed:\", result);",
									"",
									"// Save to variable (optional)",
									"pm.environment.set(\"reviewsPayload\", JSON.stringify(result));"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{handi-base-url}}/kyc/applications/:applicationId",
							"host": [
								"{{handi-base-url}}"
							],
							"path": [
								"kyc",
								"applications",
								":applicationId"
							],
							"variable": [
								{
									"key": "applicationId",
									"value": "7e7f55c4-08c6-49d7-86e7-026183c3ed33"
								}
							]
						}
					}
				},
